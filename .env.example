# ---- Telegram (required) -------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# your numeric Telegram id, or a comma separated list
ADMIN_ID=111111111
# restrict the group guard to specific chats (empty = every chat the bot is in)
WATCH_CHATS=-1001234567890

# ---- GitHub publishing (optional) ----------------------------------------
# without a token the bot still scrapes/audits and writes the index locally,
# but never pushes. A fine-grained token needs Contents: read+write.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=aaaarrr125h-rgb/Manga-Extensions
GITHUB_BRANCH=main
PUSH_ENABLED=true

# ---- Repository identity --------------------------------------------------
REPO_NAME=Shura
BADGE_LABEL=SHURA
REPO_WEBSITE=https://github.com/aaaarrr125h-rgb/Manga-Extensions
REPO_DISCORD=
SIGNING_KEY=9add655a78e96c4ec7a53ef89dccb557cb5d767489fac5e785d671a5a75d4da2

# ---- Upstream scraping ----------------------------------------------------
UPSTREAM_INDEX_JSON=https://raw.githubusercontent.com/keiyoushi/extensions/repo/index.json
UPSTREAM_SOURCE_REPO=keiyoushi/extensions-source
UPSTREAM_SOURCE_REF=main
SOURCE_SCAN=true
MAX_SOURCE_FILES=12
MAX_SCAN_PER_RUN=50
MAX_NEW_PER_RUN=40

# ---- Security policy ------------------------------------------------------
# strict 18+ policy: CONTENT_WARNING_MIXED is rejected too
ALLOW_MIXED=false
AUTO_DELETE=true
AUTO_BAN=true
# report every link that is not explicitly allowlisted (noisy, review mode)
REPORT_UNKNOWN=false

# ---- Health / dead-source cleanup ----------------------------------------
HEALTH_SLICE=60
HEALTH_WORKERS=12
DEAD_THRESHOLD=3

# ---- Scheduler (cron, 5 fields) ------------------------------------------
CRON_HARVEST=17 */6 * * *
CRON_HEALTH=41 */3 * * *
CRON_PUBLISH=23 */2 * * *
CRON_DIGEST=53 9 * * *
TIMEZONE=UTC
BOOTSTRAP_HARVEST=true
