# ---- Telegram (required) -------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# your numeric Telegram id, or a comma separated list
ADMIN_ID=111111111
# restrict the group guard to specific chats (empty = every chat the bot is in)
WATCH_CHATS=-1001234567890

# ---- GitHub publishing (optional) ----------------------------------------
# without a token the bot still scrapes/audits and writes the index locally,
# but never pushes. A fine-grained token needs Contents: read+write.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=aaaarrr125h-rgb/Manga-Extensions
GITHUB_BRANCH=main
PUSH_ENABLED=true
# Publishing is off by default and needs BOTH of these:
#   PUBLISH_MODE=allow  (configuration, set by hand)
#   a live PublishAuthorization, opened only by run_publish_phase(actor, reason)
PUBLISH_MODE=disabled

# ---- Repository identity --------------------------------------------------
REPO_NAME=Shura
BADGE_LABEL=SHURA
REPO_WEBSITE=https://github.com/aaaarrr125h-rgb/Manga-Extensions
REPO_DISCORD=
# The store's signing key, as published in repo/index.json: the SHA-256 digest
# (64 hex characters) of the certificate the extension APKs are signed with.
# Clients hash the certificate out of the APK and compare it against this value.
# Leave it empty here and set the real value in your platform's secret store.
# It is not a credential: it is public, exactly like the APKs it describes.
SIGNING_KEY=9add655a78e96c4ec7a53ef89dccb557cb5d767489fac5e785d671a5a75d4da2

# ---- Upstream scraping ----------------------------------------------------
UPSTREAM_INDEX_JSON=https://raw.githubusercontent.com/keiyoushi/extensions/repo/index.json
UPSTREAM_SOURCE_REPO=keiyoushi/extensions-source
UPSTREAM_SOURCE_REF=main
SOURCE_SCAN=true
MAX_SOURCE_FILES=12
MAX_SCAN_PER_RUN=50
MAX_NEW_PER_RUN=40

# ---- Security policy ------------------------------------------------------
# strict 18+ policy: CONTENT_WARNING_MIXED is rejected too
ALLOW_MIXED=false
AUTO_DELETE=true
AUTO_BAN=true
# report every link that is not explicitly allowlisted (noisy, review mode)
REPORT_UNKNOWN=false

# ---- Health / dead-source cleanup ----------------------------------------
HEALTH_SLICE=60
HEALTH_WORKERS=12
DEAD_THRESHOLD=3

# ---- Scheduler (cron, 5 fields) ------------------------------------------
CRON_HARVEST=17 */6 * * *
CRON_HEALTH=41 */3 * * *
# Readiness report only (dry-run). It never publishes, pushes or accepts.
CRON_PUBLISH=23 */2 * * *
CRON_DIGEST=53 9 * * *
TIMEZONE=UTC
BOOTSTRAP_HARVEST=true

# ---- POST_BETA feature flags (temporary, reversible) ----------------------
# All three default to true, so an unset environment behaves exactly as
# before. Set one to false to defer that feature for the Beta, and back to
# true to re-enable it. Nothing behind a flag is deleted -- only the call
# site is skipped, so re-enabling never means rebuilding anything.

# The Telegram group moderator. When false, group messages are no longer
# screened, deleted or banned. /help, /review, /accept and every other
# admin command keep working, and the security screeners shared with the
# repo pipeline stay active.
GROUP_GUARD_ENABLED=true

# The Shura app sidecar contract. When false, the build stops writing
# shura/manifest.json and shura/delta.json. repo/index.json, repo/index.pb
# and repo.json are still written unchanged.
SHURA_SYNC_ENABLED=true

# The daily stats digest pushed to admins. When false it is simply not
# registered with the scheduler; the counters are still collected.
DIGEST_ENABLED=true
